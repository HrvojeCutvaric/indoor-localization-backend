{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "DefaultConnection": "SET_BY_ENVIRONMENT"
  },

  "Jwt": {
    "Issuer": "IndoorLocalizationAPI",
    "Secret": "REPLACE_WITH_SECURE_KEY",
    "Audience": "IndoorLocalizationClient",
    "ExpirationInMinutes": 60
  },

  "Email": {
    "SmtpServer": "smtp.gmail.com",
    "SmtpPort": "587",
    "Username": "your.gmail@example.com",
    "Password": "your-app-password",
    "From": "your.gmail@example.com"
  }
}
